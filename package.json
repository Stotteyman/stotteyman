{
  "name": "stotteyman",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "lint:css": "stylelint '**/*.css'",
    "type-check": "tsc --noEmit",
    "test": "vitest",
    "test:e2e": "playwright test",
    "test:ci": "vitest run && playwright test",
    "lighthouse": "lighthouse-ci autorun",
    "quality": "pnpm type-check && pnpm lint && pnpm lint:css && pnpm test:ci && pnpm lighthouse",
    "db:setup": "node scripts/setup-db.js",
    "db:migrate": "node scripts/migrate.js",
    "create-assets": "node scripts/create-placeholder-assets.js",
    "analyze-bundle": "node scripts/optimize-bundle.js",
    "postbuild": "pnpm analyze-bundle"
  },
  "dependencies": {
    "next": "^14.2.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "@neondatabase/serverless": "^0.9.0",
    "@react-three/fiber": "^8.17.0",
    "@react-three/drei": "^9.114.0",
    "three": "^0.170.0",
    "xstate": "^5.0.0",
    "zustand": "^4.5.0",
    "tailwindcss": "^3.4.0",
    "autoprefixer": "^10.4.0",
    "postcss": "^8.4.0",
    "clsx": "^2.1.0",
    "class-variance-authority": "^0.7.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/three": "^0.170.0",
    "typescript": "^5.7.2",
    "eslint": "^8.57.0",
    "eslint-config-next": "^14.2.0",
    "stylelint": "^16.0.0",
    "stylelint-config-standard": "^36.0.0",
    "prettier": "^3.3.0",
    "vitest": "^2.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "jsdom": "^24.0.0",
    "@playwright/test": "^1.45.0",
    "lighthouse-ci": "^1.13.1",
    "@axe-core/playwright": "^4.9.0",
    "pa11y": "^7.0.0",
    "@testing-library/react": "^14.0.0",
    "@testing-library/jest-dom": "^6.0.0",
    "@xstate/react": "^4.0.0"
  }
}