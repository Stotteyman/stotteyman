{
  "name": "stotteyman-enterprises",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:turbo": "next dev --turbo",
    "build": "next build",
    "build:analyze": "cross-env ANALYZE=true next build",
    "build:profile": "next build --profile",
    "start": "next start",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:e2e": "playwright test",
    "test:accessibility": "playwright test --grep accessibility",
    "type-check": "tsc --noEmit",
    "analyze": "cross-env ANALYZE=true next build",
    "perf:lighthouse": "lhci autorun",
    "perf:bundle": "npm run build:analyze && npx webpack-bundle-analyzer .next/analyze/client.js",
    "deploy:check": "node scripts/deploy-check.js",
    "validate:config": "node scripts/validate-nextjs-config.js",
    "validate:types": "node scripts/validate-typescript-config.js",
    "deploy:prod": "npm run deploy:check && npm run build && npm start",
    "clean": "rm -rf .next out node_modules/.cache",
    "prepare": "husky install"
  },
  "dependencies": {
    "@next/swc-win32-x64-msvc": "^15.5.0",
    "@types/three": "^0.170.0",
    "clsx": "^2.1.1",
    "critters": "^0.0.23",
    "csurf": "^1.11.0",
    "dompurify": "^3.2.6",
    "dotenv": "^16.6.1",
    "focus-trap-react": "^10.3.1",
    "framer-motion": "^11.15.0",
    "gray-matter": "^4.0.3",
    "gsap": "^3.12.5",
    "helmet": "^8.0.0",
    "isomorphic-dompurify": "^2.26.0",
    "jsdom": "^26.1.0",
    "lottie-react": "^2.4.0",
    "lru-cache": "^11.0.2",
    "lucide-react": "^0.460.0",
    "markdown-it": "^14.1.0",
    "next": "15.5.0",
    "rate-limiter-flexible": "^5.0.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.4",
    "three": "^0.170.0",
    "web-vitals": "^4.2.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.1",
    "@lhci/cli": "^0.15.1",
    "@netlify/plugin-nextjs": "^5.7.2",
    "@next/bundle-analyzer": "^15.5.2",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/dompurify": "^3.2.0",
    "@types/jest": "^30.0.0",
    "@types/jsdom": "^21.1.7",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "autoprefixer": "^10.4.20",
    "cross-env": "^7.0.3",
    "eslint": "^9.17.0",
    "eslint-config-next": "15.5.0",
    "husky": "^9.1.7",
    "jest": "^30.0.5",
    "jest-environment-jsdom": "^30.0.5",
    "lint-staged": "^15.2.11",
    "playwright": "^1.49.1",
    "postcss": "^8.5.1",
    "prettier": "^3.4.2",
    "tailwindcss": "^3.4.17",
    "ts-jest": "^29.4.1",
    "typescript": "^5.7.2",
    "webpack-bundle-analyzer": "^4.10.2"
  }
}
