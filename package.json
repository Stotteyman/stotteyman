{
  "name": "stotteyman",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "lint:css": "stylelint '**/*.css'",
    "type-check": "tsc --noEmit",
    "test": "vitest",
    "test:e2e": "playwright test",
    "test:ci": "vitest run && playwright test",
    "lighthouse": "lighthouse-ci autorun",
    "quality": "pnpm type-check && pnpm lint && pnpm lint:css && pnpm test:ci && pnpm lighthouse",
    "db:setup": "node scripts/setup-db.js",
    "db:migrate": "node scripts/migrate.js",
    "db:init-admin": "node scripts/init-admin.js",
    "db:init-blog": "node scripts/init-blog.js",
    "analyze-bundle": "node scripts/optimize-bundle.js",
    "postbuild": "pnpm analyze-bundle"
  },
  "dependencies": {
    "@neondatabase/serverless": "^0.9.0",
    "@next-auth/prisma-adapter": "^1.0.7",
    "@prisma/client": "^6.16.2",
    "@stackframe/stack": "^2.8.36",
    "@types/bcryptjs": "^3.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "autoprefixer": "^10.4.0",
    "bcryptjs": "^3.0.2",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "jsonwebtoken": "^9.0.2",
    "next": "^15.5.3",
    "next-auth": "^4.24.11",
    "postcss": "^8.4.0",
    "prisma": "^6.16.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tailwindcss": "^3.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.9.0",
    "@playwright/test": "^1.45.0",
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^14.0.0",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "eslint": "^8.57.0",
    "eslint-config-next": "^14.2.0",
    "jsdom": "^24.0.0",
    "lighthouse-ci": "^1.13.1",
    "pa11y": "^7.0.0",
    "prettier": "^3.3.0",
    "stylelint": "^16.0.0",
    "stylelint-config-standard": "^36.0.0",
    "typescript": "^5.7.2",
    "vitest": "^2.0.0"
