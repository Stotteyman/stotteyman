# Supabase — shared W.A.G.E. Society project, `stotteyman` schema.
# The site's data lives in the `stotteyman` schema of project pqngaffhjqadrsntsvlp.
# Every PostgREST call must pin that schema (lib/supabase/client.ts does this).
NEXT_PUBLIC_SUPABASE_URL="https://pqngaffhjqadrsntsvlp.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# Service role. SERVER ONLY — bypasses RLS entirely.
# Never expose this to the browser and never prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_KEY=""

# Public site URL, used for metadata, sitemap, and OAuth redirects.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Kick livestream integration (netlify/functions/kick-*).
KICK_CLIENT_ID=""
KICK_CLIENT_SECRET=""

# ─────────────────────────────────────────────────────────────────────────────
# Studio — post once from Discord, distribute to the blog and social.
# Full runbook: "Build Notes/stotteyman-studio/SETUP.md".
# ─────────────────────────────────────────────────────────────────────────────

# Discord app (developers.discord.com). The public key verifies interaction
# signatures; without it every interaction is correctly rejected with a 401.
DISCORD_APPLICATION_ID=""
DISCORD_PUBLIC_KEY=""
DISCORD_BOT_TOKEN=""
DISCORD_GUILD_ID="1492592504606822441"

# Where the Discord adapter posts. Printed by scripts/setup-discord-server.mjs.
DISCORD_ANNOUNCE_CHANNEL_ID=""

# Who may publish, as comma-separated Discord user IDs.
# EMPTY MEANS NOBODY — this fails closed on purpose, so a missing value never
# leaves the endpoint open to everyone in the guild.
STUDIO_DISCORD_USER_IDS=""

# Shared secret guarding the queue worker endpoint. Any long random string.
STUDIO_WORKER_SECRET=""

# Meta — Facebook Page + Instagram. The Page token should be the never-expiring
# one derived from a long-lived user token, not a 2-hour Explorer token.
META_PAGE_ACCESS_TOKEN=""
META_PAGE_ID=""
META_IG_USER_ID=""
# Meta expires each Graph version ~2 years after release; v21/v22 are already gone.
META_GRAPH_VERSION="v25.0"

# YouTube Data API v3. Uploads are forced private until the Google API compliance
# audit passes — the adapter reports this rather than claiming the video is live.
YOUTUBE_CLIENT_ID=""
YOUTUBE_CLIENT_SECRET=""
YOUTUBE_REFRESH_TOKEN=""
YOUTUBE_DEFAULT_PRIVACY="private"
YOUTUBE_CATEGORY_ID="22"
