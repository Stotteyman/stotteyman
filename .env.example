# Supabase — shared W.A.G.E. Society project, `stotteyman` schema.
# The site's data lives in the `stotteyman` schema of project pqngaffhjqadrsntsvlp.
# Every PostgREST call must pin that schema (lib/supabase/client.ts does this).
NEXT_PUBLIC_SUPABASE_URL="https://pqngaffhjqadrsntsvlp.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# Service role. SERVER ONLY — bypasses RLS entirely.
# Never expose this to the browser and never prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_KEY=""

# Public site URL, used for metadata, sitemap, and OAuth redirects.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Kick livestream integration (netlify/functions/kick-*).
KICK_CLIENT_ID=""
KICK_CLIENT_SECRET=""
